
<div class="row">
    <div class="col-md-12 mb-3">
        <h2 class="page-heading"><i class="fas fa-user-clock mr-2" style="color: #4f46e5;"></i>My Appointments</h2>
        <p class="page-subheading">View your assigned appointments</p>
    </div>
    <div class="col-xl-12">
        <div class="card card-outline card-dark">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">My Appointments</h3>
            </div>
            <div class="card-body">
                <partial name="_DateRangeFilter" />
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive compact-table-container">
                    <table id="tblMyAppointmentList" style="width:100%; font-size:13px" class="table table-striped table-bordered table-sm compact-table">
                        <thead class="table-header">
                            <tr class="border-bottom-0 tr-header header">
                                <th>Client Name</th>
                                <th>Client Num</th>
                                <th>Artist </th>
                                <th>Category</th>
                                <th>Apt Date(AD)</th>
                                <th>Apt Date(BS)</th>
                                <th>Total Hours</th>
                                <th>Discount</th>
                                <th>Discount Hr</th>
                                <th>Due Amt</th>
                                <th>Paid Amt</th>
                                <th>Total Cost</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ModalView" />

@section Scripts {
    <script>
        var datatable = null;
        $(document).ready(function () {
            loadDataTable();
            $("#btnFilterLoad").on("click", function (e) {
                e.preventDefault(); // Prevent form submission if the button is inside a form
                loadDataTable();
            });
        });
        function loadDataTable() {
            const requestDto = {
                StartDateNep: $("#StartDateNep").val(),
                EndDateNep: $("#EndDateNep").val(),
                Status: $("#Status").val()
            };
            if (datatable) {
                $("#tblMyAppointmentList").DataTable().destroy();
            }
            datatable = $("#tblMyAppointmentList").DataTable({
                fixHeader: {
                    header: true,
                    headerOffset: 50
                },
                autoWidth: true,
                lengthMenu: [[25, 50, -1], [25, 50, "All"]],
                ordering: false,
                ajax: {
                    url: '/Appointment/GetAllAppointmentByArtist',
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    data: function () {
                        return JSON.stringify(requestDto);
                    },
                    dataSrc: "" // Optional, if response is an array
                },
                columns: [
                    { 'data': 'clientName' },
                    { 'data': 'clientPhoneNumber' },
                    { 'data': 'artistAssigned' },
                    { 'data': 'category' },
                    // {'data': 'referalFullName'},
                    {
                        'data': 'appointmentDate',
                        'render': function (data) {
                            return formatDate(data);
                        }
                    },
                    {'data': 'appointmentDateNep'},
                    { 'data': 'totalHours' },
                    { 'data': 'discount' },
                    { 'data': 'discountInHour' },
                    { 'data': 'dueAmount' },
                    { 'data': 'paidAmount' },
                    { 'data': 'totalCost' },
                    { 'data': 'status' },
                    {
                        'data': 'guid',
                        'render': function (data) {
                            return `
                                    <div>
                                        <a href="/Appointment/edit?guid=${data}"><i class="fas fa-edit"></i></i></a> |
                                        <a href="/Appointment/detail?guid=${data}"><i class="fas fa-eye"></i></i></a>
                                        </div>
                                    `
                        }
                    }
                ],
                createdRow: function (row, data, dataIndex) {
                    if (data.status === 'Completed') {
                        $(row).css('color', 'green'); // Hghlight row in green
                    }
                    else if (data.status == 'InProgress') {
                        $(row).css('color', 'blue'); // Hghlight row in green
                    }
                    else if (data.status == 'Cancelled') {
                        $(row).css('color', 'red'); // Hghlight row in green
                    }
                }
            });
        }
    </script>
}