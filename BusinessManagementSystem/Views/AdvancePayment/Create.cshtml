@model TattooAppointmentSystem.Models.AdvancePayment
<div class="row">
    <div class="col-md-12 mb-3">
        <h2 class="page-heading"><i class="fas fa-plus-circle mr-2" style="color: #4f46e5;"></i>Advance Payment Request</h2>
        <p class="page-subheading">Submit a new advance payment request</p>
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" asp-controller="AdvancePayment">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-12">
        <div class="card card-outline card-dark">
            <div class="card-header">
                <h3 class="card-title">Payment Details</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="UserId" class="control-label"></label>
                            @Html.DropDownListFor(model => model.UserId, (SelectList)ViewBag.AdvancePaymentSelectList["Artist"], new { @class = "form-control" })
                            <span asp-validation-for="UserId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Amount" class="control-label"></label>
                            <input asp-for="Amount" value="0" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label asp-for="Reason" class="control-label"></label>
                            <input asp-for="Reason" class="form-control" />
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <input type="submit" id="btnAdvancePaymentSubmit" value="Apply" class="btn btn-success" />
                </div>
            </div>
        </div>
    </div>
</form>
