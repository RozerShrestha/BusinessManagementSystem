@model IEnumerable<BusinessManagementSystem.Models.Menu>

<div class="row">
    <div class="col-md-12 mb-3">
        <h2 class="page-heading"><i class="fas fa-bars mr-2" style="color: #4f46e5;"></i>Menu Management</h2>
        <p class="page-subheading">Configure navigation menu items</p>
    </div>
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">All Menus</h3>
                <button type="button" class="btn btn-success btn-sm" onclick="window.location.href='@Url.Action("create", "Menu")';">
                    <i class="fas fa-plus mr-1"></i> Create New Menu
                </button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-sm">
                        <thead class="table-header">
                            <tr>
                                <th>@Html.DisplayNameFor(model => model.Id)</th>
                                <th>@Html.DisplayNameFor(model => model.Parent)</th>
                                <th>@Html.DisplayNameFor(model => model.Name)</th>
                                <th>@Html.DisplayNameFor(model => model.Url)</th>
                                <th>@Html.DisplayNameFor(model => model.Sort)</th>
                                <th>@Html.DisplayNameFor(model => model.Status)</th>
                                <th>@Html.DisplayNameFor(model => model.Icon)</th>
                                <th>@Html.DisplayNameFor(model => model.Roles)</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Id)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Parent)</td>
                                    <td><strong>@Html.DisplayFor(modelItem => item.Name)</strong></td>
                                    <td>@Html.DisplayFor(modelItem => item.Url)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Sort)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                    <td><i class="@item.Icon"></i> @Html.DisplayFor(modelItem => item.Icon)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Roles)</td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@item.Id" title="Edit"><i class="fas fa-edit"></i></a>
                                        <span class="mx-1 text-muted">|</span>
                                        <a asp-action="Delete" data-toggle="modal" data-id="@item.Id" data-type="menu" data-target="#confirmationModalDel" class="delete-btn" title="Delete"><i class="fas fa-trash-alt"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_ModalView" />
