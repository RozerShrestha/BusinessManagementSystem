@model TattooAppointmentSystem.Models.Menu
<div class="row">
    <div class="col-md-12 mb-3">
        <h2 class="page-heading"><i class="fas fa-plus-circle mr-2" style="color: #4f46e5;"></i>Create Menu</h2>
        <p class="page-subheading">Add a new navigation menu item</p>
    </div>
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Menu Details</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Parent" class="control-label"></label>
                                @Html.DropDownList("Parent", ViewData["ParentList"] as SelectList, new { @class = "form-control" })
                                <span asp-validation-for="Parent" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Url" class="control-label"></label>
                                <input asp-for="Url" class="form-control" />
                                <span asp-validation-for="Url" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                <label class="control-label">Roles (to select the roles press ctrl and click)</label>
                                @Html.ListBoxFor(m => m.Multiselect.SelectedItems, new MultiSelectList(Model.Multiselect.Items, "Value", "Text"), new { @class = "form-control select2" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Sort" class="control-label"></label>
                                <input asp-for="Sort" class="form-control" />
                                <span asp-validation-for="Sort" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Status" class="control-label"></label>
                                <select asp-for="Status" class="form-control">
                                    <option value="true">Active</option>
                                    <option value="false">In Active</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Icon" class="control-label"></label>
                                <input asp-for="Icon" class="form-control" />
                                <span asp-validation-for="Icon" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <input type="submit" value="Create" class="btn btn-success" />
                        <a href="@Url.Action("Index", "Menu")" class="btn btn-secondary ml-2" style="background-color: #64748b; color: #fff;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function  () {
            $('.select2').select2({
                placeholder: "Select options",
                allowClear: true
            });
        });
    </script>
}

