@{
    var claims = User.Identities.First().Claims.ToList();
    Layout = "_Login";
}
<div class="h-100 d-flex align-items-center justify-content-center">
    <div class="card shadow-lg" style="width:450px; margin-top:90px; border-radius: 1rem; border: none;">
        <div class="card-body text-center p-5">
            <div style="width: 64px; height: 64px; background: #eef2ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                <i class="fas fa-sign-out-alt" style="font-size: 1.5rem; color: #4f46e5;"></i>
            </div>
            <h4 style="font-weight: 700; color: #1e293b;">Logged Out</h4>
            <p style="color: #64748b; margin-bottom: 0.5rem;">@claims.FirstOrDefault(x => x.Type.Equals("nic_full_name", StringComparison.OrdinalIgnoreCase)).Value</p>
            <p style="color: #94a3b8; font-size: 0.875rem;">You have been successfully logged out.</p>
            <a href="@Url.Action("Index", "Dashboard")" class="btn btn-success mt-3" style="padding: 0.625rem 2rem;">
                <i class="fas fa-sign-in-alt mr-2"></i>Login Again
            </a>
        </div>
    </div>
</div>
