@model TattooAppointmentSystem.Models.BasicConfiguration
<div class="row">
    <div class="col-md-12 mb-3">
        <h2 class="page-heading"><i class="fas fa-user-tag mr-2" style="color: #4f46e5;"></i>Update User Role</h2>
        <p class="page-subheading">Assign roles to employees</p>
    </div>
</div>
<form asp-action="UpdateUserRole" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-12">
        <div class="card card-outline card-dark">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-user-cog mr-2"></i>Role Assignment</h3>
            </div>
            <div class="card-body">
                <div class="row align-items-end">
                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label>Employee List</label>
                            @Html.DropDownList("employeeId", ViewData["EmployeeList"] as SelectList, new {@class="form-control" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label>Roles</label>
                            @Html.DropDownList("roleId", ViewData["RoleList"] as SelectList, new {@class="form-control" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <input type="submit" value="Update Role" class="btn btn-success" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
