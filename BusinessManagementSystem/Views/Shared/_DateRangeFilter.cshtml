@model BusinessManagementSystem.Dto.RequestDto
<div class="row">
    <div class="col-md-2">
        <label asp-for="StartDateNep" class="control-label"></label>
        <input asp-for="StartDateNep" class="form-control nepaliDate" />
        <span asp-validation-for="StartDateNep" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="EndDateNep" class="control-label"></label>
        <input asp-for="EndDateNep" class="form-control nepaliDate" />
        <span asp-validation-for="EndDateNep" class="text-danger"></span>
    </div>
    @if (Model.ParameterFilter?.Contains("User") == true)
    {
        <div class="col-md-2">
            <label asp-for="UserId" class="control-label"></label>
            @Html.DropDownListFor(model => model.UserId, (SelectList)ViewBag.ArtistList, new { @class = "form-control" })
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>
    }
    @if (Model.ParameterFilter?.Contains("Status") == true)
    {
        <div class="col-md-2">
            <label asp-for="Status" class="control-label"></label>
            @Html.DropDownListFor(model => model.Status, (SelectList)ViewBag.AppointmentStatus, new { @class = "form-control", data_val = "false" })
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
    }
    @if (Model.ParameterFilter?.Contains("Settlement") == true)
    {
        <div class="col-md-2">
            <label asp-for="Settlement" class="control-label"></label>
            <select asp-for="Settlement" class="form-control">
                <option value="true">Settlement Done</option>
                <option value="false" selected>Settlement Pending</option>
                <option value="ALL" selected>All Settlement</option>

            </select>
        </div>
    }
    <div class="col-md-2">
        <input type="button" id="btnFilterLoad" value="Load" class="btn btn-success" style="margin-top:30px" />
    </div>
</div>
